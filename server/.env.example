# Aswanna Server Environment Configuration Example
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/aswanna
JWT_SECRET=dev-jwt-secret-change-in-prod
JWT_EXPIRES_IN=7d
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=20

# End-of-season forecasting overlaps SO1 (cost prediction).
# Frozen and disabled by default for SO3 deliverable.
FORECAST_MODE=off

# Voice Speech & Dataset Collection (Phase 2)
VOICE_ASR=browser
VOICE_SERVICE_URL=http://127.0.0.1:8001
VOICE_INTERNAL_TOKEN=change-in-prod-voice-internal-secret
VOICE_DATASET_COLLECTION=off
VOICE_DATASET_STORAGE_DIR=private_dataset_storage/audio
VOICE_DATASET_RETENTION_DAYS=365
VOICE_PSEUDONYMIZATION_KEY=change-in-prod-high-entropy-pseudo-key-32chars-min
VOICE_DATASET_MAX_CONTRIBUTOR_BYTES=104857600
VOICE_DATASET_MIN_FREE_DISK_BYTES=52428800

